# Application Environment Configuration Example
# Copy this file to .env.local and populate with your credentials.

# Application Environment
NODE_ENV=production
PORT=3000

# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-side only - NEVER expose service role key to frontend bundles or client components
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=student-assets

# ==============================================================================
# AI PROVIDER CONFIGURATION (Multi-Provider Abstraction Layer)
# ==============================================================================
# Active Provider: gemini | openrouter | groq | ollama (default: gemini)
AI_PROVIDER=gemini
# Optional fallback enablement: automatically try secondary provider on rate limits/downtime
AI_ENABLE_FALLBACK=true

# 1. Google Gemini Provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# 2. OpenRouter Provider
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 3. Groq Provider
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 4. Local Ollama Provider (Optional Self-Hosted / Offline Development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Development-only offline deterministic mock (STRICTLY DISALLOWED in production)
ALLOW_DEV_AI_MOCK=false

# PII Encryption Secret (Minimum 32 characters for AES-256)
ENCRYPTION_SECRET=your_32_character_encryption_secret_key_here
