      "domain": "scholarship"
    },
    {
      "source_pattern": "((naa|na)\\s+)?attendance\\s+(entha(\\s+undi)?|cheppu)",
      "target_normalized": "what is my attendance",
      "intent": "ATTENDANCE_SELF",
      "domain": "attendance"
    },
    {
      "source_pattern": "(my|naa|na)\\s+application(\\s+status)?\\s+(enti|cheppu)",
      "target_normalized": "what is my application status",
      "intent": "APPLICATION_SELF",
      "domain": "application"
    },
    {
      "source_pattern": "hostel\\s+room\\s+(cheppu|enti|details)",
