      "intent": "HOSTEL_SELF",
      "domain": "hostel"
    },
    {
      "source_pattern": "admission\\s+ki\\s+(em|emi)?\\s*documents?\\s+kavali",
      "target_normalized": "what documents are required for admission",
      "intent": "ADMISSION_DOCUMENTS",
      "domain": "admissions"
    },
    {
      "source_pattern": "library\\s+timings?\\s+(enti|eppudu)",
      "target_normalized": "what are the library timings",
      "intent": "KNOWLEDGE_SEARCH",
      "domain": "campus"
    }
  ]
